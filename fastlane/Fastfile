# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

default_platform(:ios)

platform :ios do

  # App Store Connect API key, stored encrypted via git-secret (`git secret reveal`)
  def api_key_path
    "./fastlane/api_key.json"
  end

  # Provisioning profile name prefix per bundle identifier.
  # "<prefix> <Type>" must match PROVISIONING_PROFILE_SPECIFIER in project.yml.
  def profile_prefixes
    {
      "com.tr1ckyf0x.wake-on-lan" => "Wake On Lan",
      "com.tr1ckyf0x.wake-on-lan.intent" => "Wake On Lan Siri Intent"
    }
  end

  def profile_names(type_suffix)
    profile_prefixes.transform_values { |prefix| "#{prefix} #{type_suffix}" }
  end

  # Runs `match` once per bundle identifier so every profile keeps its own name
  # (match applies a single `profile_name` to all identifiers otherwise).
  def match_profiles(type:, type_suffix:, **options)
    profile_names(type_suffix).each do |app_identifier, profile_name|
      match(
        type: type,
        app_identifier: app_identifier,
        profile_name: profile_name,
        generate_apple_certs: true,
        **options
      )
    end
  end

  def keychain_options
    return {} unless ENV["KEYCHAIN_NAME"]

    {
      keychain_name: ENV["KEYCHAIN_NAME"],
      keychain_password: ENV["KEYCHAIN_PASSWORD"]
    }
  end

  lane :sync_development_certificates do
    match_profiles(type: "development", type_suffix: "Development", readonly: true)
  end

  lane :sync_release_certificates do
    match_profiles(type: "appstore", type_suffix: "AppStore", readonly: true, **keychain_options)
  end

  lane :generate_development_certificates do
    match_profiles(type: "development", type_suffix: "Development", api_key_path: api_key_path)
  end

  lane :generate_release_certificates do
    match_profiles(type: "appstore", type_suffix: "AppStore", api_key_path: api_key_path)
  end

  # The schemes a release depends on. Generated by XcodeGen from the `scheme:` keys in project.yml.
  REQUIRED_SCHEMES = ["Wake On LAN", "Intent"].freeze

  desc "Run the SharedCode unit tests. CI check"
  lane :test do
    run_tests(
      scheme: "SharedCodeTests",
      device: "iPhone 17",
      xcodebuild_formatter: "mint run xcbeautify"
    )
  end

  desc "Build Release without signing and assert the bundle is shippable. CI check"
  lane :verify_release do
    root = File.expand_path("..", __dir__)

    # A shared scheme going missing is invisible until a release cannot be built: the project is
    # generated, so nothing in git shows the loss. It has happened once already, when the build
    # configurations were renamed.
    #
    # Parse the JSON rather than searching the plain output: `-list` prints the project name in its
    # header and every target under "Targets:", so a substring test for "Wake On LAN" or "Intent"
    # passes whether or not the scheme still exists. This guard shipped in that broken form once.
    listed = JSON.parse(sh("xcodebuild -project '#{root}/Wake On LAN.xcodeproj' -list -json", log: false))
    schemes = listed.dig("project", "schemes") || []
    missing = REQUIRED_SCHEMES - schemes
    unless missing.empty?
      UI.user_error!("Shared scheme(s) missing from the generated project: #{missing.join(', ')}. Found: #{schemes.join(', ')}")
    end

    # Release rather than Debug: optimisation, dead stripping and the Crashlytics phase otherwise run
    # for the first time when a tag is pushed. Nothing in the sources is `#if DEBUG`, so this loses
    # no coverage against the Debug build it replaced.
    #
    # The Crashlytics phase runs on every build, and dSYMs for a binary that never ships have no
    # business in the dashboard.
    ENV["SKIP_CRASHLYTICS_UPLOAD"] = "1"

    derived_data = "#{root}/build/verify"
    build_app(
      scheme: "Wake On LAN",
      configuration: "Release",
      skip_codesigning: true,
      skip_package_ipa: true,
      skip_archive: true,
      derived_data_path: derived_data,
      destination: "generic/platform=iOS Simulator",
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      xcodebuild_formatter: "mint run xcbeautify"
    )

    app = Dir["#{derived_data}/Build/Products/Release-*/*.app"].first
    UI.user_error!("The Release build produced no .app under #{derived_data}") if app.nil?
    sh("'#{root}/Scripts/verify_release_bundle.sh' '#{app}'")
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do
    # A tag that disagrees with MARKETING_VERSION ships a build labelled with the wrong version, and
    # nothing downstream notices. Read straight out of the xcconfig, which is the source of truth --
    # asking xcodebuild for it would cost a project load for one string. Only a tag push has a
    # version to check; workflow_dispatch runs from a branch and skips this.
    if ENV["GITHUB_REF_TYPE"] == "tag"
      tag = ENV["GITHUB_REF_NAME"].to_s
      config = File.read(File.expand_path("../Configs/Base.xcconfig", __dir__))
      marketing_version = config[/^MARKETING_VERSION\s*=\s*(\S+)/, 1]
      unless tag == marketing_version
        UI.user_error!("Tag #{tag} does not match MARKETING_VERSION #{marketing_version} in Configs/Base.xcconfig")
      end
    end

    # The explicit `build_number:` is load-bearing, not decoration. `CURRENT_PROJECT_VERSION` lives in
    # Configs/Base.xcconfig, and agvtool reads project.pbxproj without resolving xcconfigs, so
    # `agvtool what-version` exits 6 here. fastlane only tolerates that because a number was passed:
    # `raise "Apple Generic Versioning is not enabled." if agv_disabled && params[:build_number].nil?`.
    # Drop the argument and the release stops working, and only at tag-push time.
    #
    # What actually carries the number into the build is agvtool rewriting CFBundleVersion in both
    # Info.plist files, replacing `$(CURRENT_PROJECT_VERSION)` with a literal for the duration of the
    # run. The value in the xcconfig never participates in a release.
    increment_build_number(
      build_number: latest_testflight_build_number(api_key_path: api_key_path) + 1,
      xcodeproj: "Wake On LAN.xcodeproj"
    )

    build_app(
      scheme: "Wake On LAN",
      include_bitcode: false,
      xcodebuild_formatter: "mint run xcbeautify",
      export_options: {
        provisioningProfiles: profile_names("AppStore")
      }
    )

    # Wait for App Store Connect to finish processing. With the wait skipped and no changelog,
    # pilot returns right after the upload and never reaches its distribute step, so a build that
    # fails processing is still reported as a successful release.
    upload_to_testflight(
      api_key_path: api_key_path,
      # Bound how long a stalled processing queue can hold the self-hosted runner: without this the
      # watcher polls indefinitely and the job only ends at GitHub's six-hour default. The upload
      # has already succeeded by the time this fires, so a timeout costs a red run, not the build.
      wait_processing_timeout_duration: 1800
    )
  end
end
