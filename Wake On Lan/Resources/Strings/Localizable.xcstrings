    "DonateScreen.Screen.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Donations do not unlock any extra features in the application. The application is provided as is and any donations are your gratitude for our work."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Донаты не разблокируют каких-либо дополнительных функций в приложении. Приложение предоставляется как есть и любые пожертвования являются вашей благодарностью за нашу работу."
          }
        }
      }
    },
    "DonateScreen.Screen.LoadingFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load donations. Check your connection and open this screen again."
