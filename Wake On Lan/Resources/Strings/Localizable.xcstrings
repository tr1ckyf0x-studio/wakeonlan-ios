    "AddHost.Form.Field.Host.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IP address or domain name of the target computer. Instead, you may use the broadcast IP of your sub-network, for example 192.168.0.255, 192.168.1.255, or 10.0.0.255. If field is not specified, 255.255.255.255 will be used."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "IP-адрес или доменное имя вашего компьютера. Также, вы можете использовать широковещательный IP-адрес вашей подсети, например 192.168.0.255, 192.168.1.255 или 10.0.0.255. Если не указано, будет использован 255.255.255.255."
          }
        }
      }
    },
    "AddHost.Form.Field.Host.Placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "255.255.255.255"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "255.255.255.255"
          }
        }
      }
    },
    "AddHost.Form.Field.Host.Title": {
      "extractionState": "manual",
