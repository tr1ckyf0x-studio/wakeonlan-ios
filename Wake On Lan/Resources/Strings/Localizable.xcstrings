    "AddHost.Form.Field.Port.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The port magic packet will be sent to. 9 is usually supported by Ethernet cards. You may also try 7 or 0."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wake-On-Lan порт. 9 обычно поддерживается картами Ethernet, в противном случае вы можете попробовать 7 или 0."
          }
        }
      }
    },
