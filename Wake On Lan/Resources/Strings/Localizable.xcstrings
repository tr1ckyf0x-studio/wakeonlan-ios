    "AddHost.Form.Field.MacAddress.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MAC address of the target computer. It can be found in the Ethernet network settings of the computer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MAC-адрес вашего компьютера. Вы можете найти его в настройках сети Ethernet."
          }
        }
      }
    },
