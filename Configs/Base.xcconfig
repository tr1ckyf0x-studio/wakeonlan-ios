// Build settings shared by every target.
//
// NOTE: XcodeGen parses the attached xcconfig — following its `#include` chain — before writing its
// own setting presets, and omits every key the file already declares. That holds whether the file is
// attached to a target or to the project, so a setting kept here wins on its own merits rather than
// because of where the file is attached. The four-file include chain is convention, not necessity.
//
// An earlier version of this comment claimed the reverse. Verify a precedence question by
// regenerating and grepping project.pbxproj, not by reading prose. See BACKLOG.md.

// iPhone only. XcodeGen's iOS preset would write "1,2" here if this line were absent.
TARGETED_DEVICE_FAMILY = 1

SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES

SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED = YES
CLANG_ANALYZER_LOCALIZABILITY_EMPTY_CONTEXT = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = YES

DEVELOPMENT_TEAM = SGM5527A99
CODE_SIGN_STYLE = Manual

MARKETING_VERSION = 1.7.0
CURRENT_PROJECT_VERSION = 1

// Xcode's "Validate Project Settings" recommendations, accepted here rather than through the
// dialog: the dialog edits `Wake On LAN.xcodeproj`, which is regenerated from `project.yml` and
// would lose them at the next `xcodegen` run.

// Adds `extension SwiftUI.Color`/`UIColor`/`Image` accessors on top of the `ColorResource` symbols
// that are generated by default.
//
// This is why the neumorphic colorsets are named `LegacyPrimary`/`LegacySecondary` rather than
// `Primary`/`Secondary`: the generator refuses to shadow SwiftUI's own `Color.primary` and
// `Color.secondary` and emits `#warning` in their place, which `SWIFT_TREAT_WARNINGS_AS_ERRORS`
// turns into a build failure. Any new asset needs a name that is not already a member of
// `SwiftUI.Color`, `UIColor` or `Image`.
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES

// Emits `LocalizedStringResource` symbols for every string catalog into DerivedSources, the same way
// `actool` emits the asset symbols. Off by default and not one of XcodeGen's presets.
//
// This used to sit in App.xcconfig, but Xcode's "Validate Project Settings" asks for it on the
// *project*, and the Intent target has a catalog of its own — `IntentSharedSources/Intents.xcstrings`,
// which is built into both targets.
STRING_CATALOG_GENERATE_SYMBOLS = YES

// Runs build-phase scripts under a sandbox that denies reads and writes outside their declared
// inputs and outputs.
ENABLE_USER_SCRIPT_SANDBOXING = YES
